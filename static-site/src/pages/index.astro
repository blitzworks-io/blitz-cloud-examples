---
const built = new Date().toISOString().slice(0, 10);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Static site on blitz.cloud</title>
  </head>
  <body>
    <main>
      <h1>It works.</h1>
      <p>This page was built with Astro on {built} and is served by nginx from a Docker image.</p>
      <p><a href="/about/">About this example</a></p>
    </main>
  </body>
</html>
